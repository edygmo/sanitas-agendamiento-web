<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>Sanitas | Agenda</title><link rel="stylesheet" href="${pageContext.request.contextPath}/estilos.css"></head><body><header>Clínica Sanitas · Proyecto académico</header><main><h1>Agendamiento de citas médicas</h1><p><c:out value="${mensaje}"/></p><section><h2>Nueva cita</h2><form method="post" action="citas"><input type="hidden" name="accion" value="guardar"><label>Paciente<select name="paciente" required><c:forEach items="${pacientes}" var="p"><option value="${p.id}"><c:out value="${p.nombre}"/></option></c:forEach></select></label><label>Médico<select name="medico" required><c:forEach items="${medicos}" var="m"><option value="${m.id}"><c:out value="${m.nombre}"/></option></c:forEach></select></label><label>Fecha y hora (Colombia)<input type="datetime-local" name="fecha" required></label><button>Agendar cita</button></form></section><section><h2>Citas registradas</h2><table><thead><tr><th>Paciente</th><th>Médico</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach items="${listaCitas}" var="a"><tr><td><c:out value="${a.paciente}"/></td><td><c:out value="${a.medico}"/></td><td><c:out value="${a.fecha}"/></td><td><c:out value="${a.estado}"/></td><td><c:if test="${a.estado eq 'PENDIENTE'}"><form method="post" action="citas"><input type="hidden" name="accion" value="estado"><input type="hidden" name="id" value="${a.id}"><button name="nuevoEstado" value="ATENDIDA">Atender</button><button name="nuevoEstado" value="CANCELADA">Cancelar</button></form></c:if><form method="post" action="citas" onsubmit="return confirm('¿Eliminar cita?')"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="id" value="${a.id}"><button>Eliminar</button></form></td></tr></c:forEach></tbody></table></section></main></body></html>